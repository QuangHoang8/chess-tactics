{
  "name": "chess-tactics",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck && pnpm exec tsc --noEmit -p prisma/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm build && pnpm -r --if-present run test",
    "test:workspace": "vitest run",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@node-rs/argon2": "^2.0.2",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@chess-tactics/domain": "workspace:*",
    "@prisma/client": "6.19.3",
    "prisma": "^6.2.1"
  }
}
