# Copy to .env for local development. Never commit the real .env (see .gitignore).

# Local dev Postgres, matches docker-compose.yml.
DATABASE_URL="postgresql://chess_tactics:chess_tactics@localhost:5432/chess_tactics?schema=public"

# apps/api
PORT=3000
JWT_SECRET="replace-with-a-long-random-value"
CORS_ORIGIN="http://localhost:5173"

# Bootstrap user, created by the Phase 1 seed command (plan §1.4). No self-registration.
SEED_USER_EMAIL="owner@example.com"
SEED_USER_PASSWORD="replace-with-a-strong-password"
